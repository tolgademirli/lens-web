# Poster/OG endpoint'leri (api/) bu ikisini process.env üzerinden de okur —
# Vercel proje ayarlarında tanımlı olmaları yeterli, ayrı bir değişken gerekmez.
# Lokalde vite.config.ts köprüyü kuruyor (`npm run dev:local`).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
