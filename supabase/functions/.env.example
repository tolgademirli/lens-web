# Edge function'ları lokalde çalıştırmak için:
#
#   cp supabase/functions/.env.example supabase/functions/.env
#   # .env'i doldur (aşağıya bak), sonra:
#   npx supabase functions serve --env-file supabase/functions/.env
#
# supabase/functions/.env gitignore kapsamındadır — gerçek anahtarlar commit edilmez.
# SUPABASE_URL ve SUPABASE_SERVICE_ROLE_KEY'i buraya YAZMA: lokal stack onları
# fonksiyon ortamına kendisi enjekte eder.

# analyze + extract-works + daily-discovery için zorunlu.
# Yoksa bu fonksiyonlar lokalde 500 döner.
# Anahtarı console.anthropic.com üzerinden al.
ANTHROPIC_API_KEY=

# send-weekly-picks için. BİLEREK BOŞ BIRAK.
# Doldurursan lokal test GERÇEK e-posta gönderir — lokal ortamın amacı tam olarak
# bunu önlemek. Mail akışını lokalde görmek istiyorsan Mailpit'i kullan:
# http://127.0.0.1:54324
RESEND_API_KEY=

# send-weekly-picks çağrısını koruyan header (x-weekly-picks-secret).
# Lokalde herhangi bir değer olabilir; production'daki ile aynı olması gerekmez.
WEEKLY_PICKS_SECRET=local-dev-secret
WEEKLY_PICKS_REPLY_TO=local@example.com
WEEKLY_PICKS_FROM=local@example.com

# Rapor linklerinin tabanı. Lokalde Vite dev sunucusu.
SITE_URL=http://localhost:5173

# Bilerek boş: lokal test production PostHog projesine event göndermesin.
POSTHOG_KEY=
POSTHOG_HOST=
